# nerima-lisp standard .gitignore
# Copy to <repo>/.gitignore and append repository-specific entries below the
# marked section. Everything above the marker must stay identical across repos
# so that "is this artifact ignored?" has the same answer everywhere.

# --- Common Lisp build output ---
*.fasl
*.fas
*.lib
*.dfsl
*.ufsl
*.fsl

# --- Nix ---
/result
/result-*
/.direnv/

# --- Test and coverage output ---
/coverage/
/coverage-report/
/*-coverage-report/
*.coverage
coverage.dat
/__snapshots__/
/*-snapshots/

# --- Local caches and scratch space ---
/.cache/
/.deps/
/tmp/
/.worktrees/
/.paredit.cleanup/

# --- Editor and OS noise ---
.DS_Store
*~
\#*\#
.\#*

# --- Repository-specific entries below this line ---

# Serena's language-server cache. Local tool state, not build output, so it
# has no counterpart in the shared section above.
/.serena/cache/

# Scratch directory used when reproducing handler bugs by hand.
/tmp-debug/
